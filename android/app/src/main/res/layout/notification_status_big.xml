<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical">
    <TextView android:id="@+id/status_title"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="15sp" android:maxLines="2" android:ellipsize="end"
        android:includeFontPadding="false" />
    <Chronometer android:id="@+id/status_clock"
        android:layout_width="match_parent" android:layout_height="38dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title"
        android:textSize="23sp" android:textStyle="bold" android:singleLine="true"
        android:includeFontPadding="false" android:gravity="center_vertical" />
    <TextView android:id="@+id/status_details"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:textSize="13sp" android:maxLines="2" android:ellipsize="end"
        android:includeFontPadding="false" />
    <TextView android:id="@+id/status_elapsed_detail"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Line2"
        android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
        android:includeFontPadding="false" />
</LinearLayout>
