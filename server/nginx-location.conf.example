# Place inside the user's EXISTING HTTPS server block for their chosen domain.
# Do not use this fragment as a whole nginx configuration.
location ^~ /api/shares {
    # The path contains the secret read code. Keep it out of access/error logs.
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 1m;
    client_body_timeout 15s;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_request_buffering on;
    proxy_buffering on;
    proxy_cache off;
    proxy_pass http://127.0.0.1:8787;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For "";
    proxy_set_header X-Forwarded-Proto "";
    proxy_set_header Cookie "";
    proxy_set_header Connection "";
}
